#!/sbin/sh
# Ubuntu Touch for Xiaomi Pad 5 (nabu) — complete recovery installer (TWRP / OrangeFox)
#  - ArrowOS vendor + odm  -> logical partitions of the ACTIVE slot (via /dev/block/mapper)
#  - vbmeta, vbmeta_system, boot, vendor_boot, dtbo -> ACTIVE slot
#  - Ubuntu Touch system  -> /data/ubuntu.img
# Existing Ubuntu Touch user data in /data is kept, so the same zip also works as an update.
# Never touches the bootloader lock state.

OUTFD="/proc/self/fd/$2"
ZIP="$3"

ui_print() { echo "ui_print $1" > "$OUTFD"; echo "ui_print" > "$OUTFD"; }
abort()    { ui_print " "; ui_print "!! $1"; ui_print " "; rm -rf /tmp/ut-nabu; exit 1; }
want_sum() { grep " images/$1\$" "$TMP/SHA256SUMS" | cut -d" " -f1; }

ui_print " "
ui_print "*******************************************"
ui_print "   Ubuntu Touch  -  Xiaomi Pad 5 (nabu)"
ui_print "*******************************************"
ui_print "Note: this project was created in cooperation"
ui_print "with an AI assistant. It is experimental:"
ui_print "use it at your own risk."

# --- device check
DEV="$(getprop ro.product.device) $(getprop ro.build.product) $(getprop ro.product.vendor.device) $(getprop ro.boot.hwname)"
case "$DEV" in
    *nabu*) ui_print "- Device: Xiaomi Pad 5 (nabu)";;
    *) abort "This zip is only for the Xiaomi Pad 5 (nabu). Found: $DEV";;
esac

# --- active slot and block devices
SLOT="$(getprop ro.boot.slot_suffix)"
[ -n "$SLOT" ] || SLOT="_$(getprop ro.boot.slot)"
case "$SLOT" in _a|_b) ui_print "- Active slot: ${SLOT#_}";; *) abort "Cannot detect the active slot";; esac
BYNAME=""
for d in /dev/block/bootdevice/by-name /dev/block/by-name /dev/block/platform/soc/1d84000.ufshc/by-name; do
    [ -e "$d/boot$SLOT" ] && { BYNAME="$d"; break; }
done
[ -n "$BYNAME" ] || abort "Cannot find the partition table (by-name)"
MAPPER=/dev/block/mapper
for p in vendor odm; do
    [ -e "$MAPPER/$p$SLOT" ] || abort "Logical partition $p$SLOT not found. Is the tablet on stock HyperOS? Use the fastboot installer."
done

# --- /data
if ! grep -q " /data " /proc/mounts; then
    mount /data 2>/dev/null || abort "Cannot mount /data. Format Data first (Wipe > Format Data > yes)."
fi
[ -d /data/media/0 ] && [ ! -r /data/media/0 ] && abort "/data is encrypted. Format Data first (Wipe > Format Data > yes)."
FREE_KB=$(df -k /data | awk 'NR==2 {print $4}')
[ -f /data/ubuntu.img ] && FREE_KB=$((FREE_KB + $(du -k /data/ubuntu.img | cut -f1)))
[ "$FREE_KB" -ge $((7 * 1024 * 1024)) ] || abort "Not enough space on /data (about 7 GB needed)."

TMP=/tmp/ut-nabu; rm -rf "$TMP"; mkdir -p "$TMP"
unzip -o -q "$ZIP" SHA256SUMS -d "$TMP" || abort "SHA256SUMS missing from the zip"

# --- small images: unpack, verify, write
ui_print "- Checking images..."
for f in boot vendor_boot dtbo vbmeta vbmeta_system; do
    unzip -o -q "$ZIP" "images/$f.img" -d "$TMP" || abort "images/$f.img missing from the zip"
    [ "$(want_sum $f.img)" = "$(sha256sum "$TMP/images/$f.img" | cut -d" " -f1)" ] || abort "Checksum error on $f.img: corrupted download"
done

# --- vendor and odm (ArrowOS) into the logical partitions
for p in vendor odm; do
    ui_print "- Installing $p$SLOT"
    umount "/$p" 2>/dev/null
    NEED=$(grep " images/$p.img.size\$" "$TMP/SHA256SUMS" | cut -d" " -f1)
    HAVE=$(blockdev --getsize64 "$MAPPER/$p$SLOT" 2>/dev/null)
    if [ -n "$NEED" ] && [ -n "$HAVE" ] && [ "$HAVE" -lt "$NEED" ]; then
        abort "Partition $p$SLOT is too small ($HAVE < $NEED). Use the fastboot installer."
    fi
    blockdev --setrw "$MAPPER/$p$SLOT" 2>/dev/null
    SUM=$(unzip -p "$ZIP" "images/$p.img.gz" | gzip -dc | tee "$MAPPER/$p$SLOT" | sha256sum | cut -d" " -f1)
    [ "$SUM" = "$(want_sum $p.img)" ] || abort "Writing $p$SLOT failed (checksum mismatch). Flash this zip again."
done
sync

for p in vbmeta vbmeta_system boot vendor_boot dtbo; do
    ui_print "- Flashing $p$SLOT"
    dd if="$TMP/images/$p.img" of="$BYNAME/$p$SLOT" bs=4096 2>/dev/null || abort "Writing $p$SLOT failed"
done
sync

# --- system image
ui_print "- Installing Ubuntu Touch system (a few minutes)..."
rm -f /data/ubuntu.img.new
SUM=$(unzip -p "$ZIP" images/ubuntu.img.gz | gzip -dc | tee /data/ubuntu.img.new | sha256sum | cut -d" " -f1)
[ "$SUM" = "$(want_sum ubuntu.img)" ] || { rm -f /data/ubuntu.img.new; abort "Unpacking ubuntu.img failed (no space or corrupted zip)"; }
mv -f /data/ubuntu.img.new /data/ubuntu.img
chmod 644 /data/ubuntu.img
sync
rm -rf "$TMP"

ui_print " "
ui_print "- Done. Reboot to system: the first boot takes 1-2 minutes."
ui_print " "
exit 0
