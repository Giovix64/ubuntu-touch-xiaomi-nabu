#!/bin/sh
# Estende il filesystem di userdata a tutta la partizione.
# L'installer flasha un ext4 piccolo (8 GB) uguale per tutti i modelli (128/256 GB):
# qui lo si allarga online. Se e' gia' grande quanto la partizione non fa nulla.
DEV=$(findmnt -no SOURCE /userdata 2>/dev/null)
[ -b "$DEV" ] || exit 0
[ "$(findmnt -no FSTYPE /userdata)" = ext4 ] || exit 0
# resize2fs non fa nulla se il filesystem occupa gia' tutta la partizione
exec resize2fs "$DEV"
